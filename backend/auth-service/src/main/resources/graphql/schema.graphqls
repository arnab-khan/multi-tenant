type Query {
    me: User
    usernameExists(username: String!): UsernameExistsResponse!
}

type UsernameExistsResponse {
    exists: Boolean!
}

input AddUserInput {
    name: String!
    username: String!
    password: String!
}

type Mutation {
    logout: Boolean!
    login(input: LoginInput!): LoginResponse!
    addUser(input: AddUserInput!): User!
}

input LoginInput {
    username: String!
    password: String!
}

type LoginResponse {
    success: Boolean!
    message: String!
    user: User
}

type User {
    id: ID!
    name: String!
    username: String!
    role: Role!
    email: String
}

enum Role {
    USER
}
