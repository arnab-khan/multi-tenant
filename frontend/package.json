{
  "name": "multi-tenant-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others-on-fail --names shell,auth,profile,dynamic-sites,dynamic-forms \"ng serve shell --port 4200\" \"ng serve auth --port 4201\" \"ng serve profile --port 4202\" \"ng serve dynamic-sites --port 4203\" \"ng serve dynamic-forms --port 4204\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:shell": "node --import @angular-architects/native-federation/node-preload dist/shell/server/server.mjs",
    "serve:ssr:dynamic-sites": "node --import @angular-architects/native-federation/node-preload dist/dynamic-sites/server/server.mjs"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "cors": "^2.8.5",
    "es-module-shims": "^2.8.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "^22.1.3",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@softarc/native-federation-orchestrator": "^4.6.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^10.0.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
